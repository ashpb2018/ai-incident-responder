# ─── Backend selection ───────────────────────────────────────────────────────
# One of: anthropic | bedrock | ollama
LLM_BACKEND=anthropic

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── AWS Bedrock ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Either a bearer API key, or IAM credentials, or the default AWS chain.
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Ollama / OpenAI-compatible ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Observability integrations ──────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ─── Kubernetes ───────────────────────────────────────────────────────────────
# Defaults to ~/.kube/config
KUBECONFIG=
KUBECTL_TIMEOUT=30

# ─── Webhook signature secrets (recommended in production) ────────────────────
PAGERDUTY_WEBHOOK_SECRET=
OPSGENIE_WEBHOOK_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
# Bind to loopback by default; set 0.0.0.0 only behind a trusted gateway.
HOST=127.0.0.1
PORT=8080

# ─── Agent limits ─────────────────────────────────────────────────────────────
MAX_AGENT_STEPS=20
MAX_TOKENS=8000
# Only investigate alerts at or above this severity: critical|high|medium|low|info
MIN_SEVERITY=high
